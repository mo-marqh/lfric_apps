  <context id = "xios">
    <variable_definition>
      <variable_group id = "buffer">
        <variable id = "optimal_buffer_size" type = "string" >performance</variable>
        <variable id = "buffer_size_factor" type = "double" >$XIOS_BUFFER_SIZE_FACTOR</variable>
        <variable id = "min_buffer_size" type = "int" >$XIOS_MIN_BUFFER_SIZE</variable>
      </variable_group>

      <variable_group id = "parameters" >
        <variable id = "using_server" type = "bool" >$XIOS_SERVER_MODE_XML</variable>
        <variable id = "info_level" type = "int" >$XIOS_INFO_LEVEL</variable>
        <variable id = "print_file" type="bool">$XIOS_PRINT_FILE</variable>
      </variable_group>
    </variable_definition>
  </context>
